{
  "manifest_version": 3,
  "name": "ChromeToolbox",
  "version": "1.9.5",
  "description": "实用的网页工具集合",
  "permissions": ["activeTab", "scripting", "declarativeNetRequest", "storage", "contextMenus", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["image-preview.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["marked.min.js", "purify.min.js", "resource-preview.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}